# Copy to .env and fill in what you use. .env is read by the backend only and is
# never served to the browser. Never commit .env.

# Server
TRADER_HOST=127.0.0.1
TRADER_PORT=8000

# Background refresh
TRADER_BACKGROUND_UNIVERSE=nifty100     # nifty50 | nifty100 | nifty200 | nifty500 | midcap150 | smallcap250 ...
TRADER_SCAN_EVERY_MIN=10                # while NSE is open
TRADER_SCAN_EVERY_MIN_CLOSED=120        # outside market hours
TRADER_NEWS_EVERY_MIN=10
TRADER_FETCH_WORKERS=4                  # parallel Yahoo requests; keep it small and polite
TRADER_ENABLE_SCREENER=1                # fundamentals from Screener.in company pages (0 to disable)

# Telegram alerts (optional): create a bot with @BotFather, send it a message,
# then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Licensed real-time market data (optional, not wired in this version; see README)
KITE_API_KEY=
KITE_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_JWT_TOKEN=
